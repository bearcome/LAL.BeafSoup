@page "/"
@attribute [AllowAnonymous]
@inject IUiTextProvider UiText

<section class="home-hero">
    <div class="home-hero-copy">
        <p class="home-eyebrow"><span class="home-eyebrow-mark" aria-hidden="true"></span><T Key="ui.dashboard.eyebrow" /></p>
        <h1><T Key="ui.dashboard.headline" /></h1>
        <p class="home-tagline"><T Key="ui.dashboard.tagline" /></p>
        <div class="home-actions">
            <a class="button-link primary" href="/tree">
                <T Key="ui.dashboard.cta.start" />
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
            </a>
            <a class="button-link secondary" href="/trainer"><T Key="ui.nav.trainer" /></a>
        </div>
        <AuthorizeView>
            <NotAuthorized>
                <p class="home-login-note">
                    <T Key="ui.dashboard.login-prompt" />
                    <a href="/login"><T Key="ui.nav.login" /></a>
                    <span aria-hidden="true">/</span>
                    <a href="/register"><T Key="ui.auth.submit.register" /></a>
                </p>
            </NotAuthorized>
        </AuthorizeView>
    </div>

    <aside class="home-demo" aria-label="@UiText.Text("ui.dashboard.feature.title.morphology")">
        <div class="demo-header">
            <span><T Key="ui.dashboard.feature.title.morphology" /></span>
            <span class="demo-level">A1</span>
        </div>
        <div class="demo-bridge">
            <div class="demo-language">
                <span><T Key="ui.dashboard.demo.target" /></span>
                <strong lang="de"><T Key="ui.dashboard.demo.word" /></strong>
            </div>
            <svg class="demo-connector" viewBox="0 0 64 32" fill="none" aria-hidden="true">
                <path d="M4 16h52M47 7l9 9-9 9" stroke="currentColor" stroke-width="1.5" />
                <circle cx="4" cy="16" r="3" fill="currentColor" />
            </svg>
            <div class="demo-language demo-meaning">
                <span><T Key="ui.trainer.definition" /></span>
                <strong><T Key="ui.dashboard.demo.meaning" /></strong>
            </div>
        </div>
        <div class="demo-forms" lang="de">
            <span><T Key="ui.dashboard.demo.form.first" /></span>
            <span><T Key="ui.dashboard.demo.form.second" /></span>
            <span><T Key="ui.dashboard.demo.form.third" /></span>
        </div>
        <p class="demo-caption"><T Key="ui.dashboard.demo.caption" /></p>
    </aside>
</section>

<section class="home-paths">
    <div class="section-heading">
        <p class="section-kicker"><T Key="ui.app.brand" /></p>
        <h2><T Key="ui.dashboard.paths.title" /></h2>
    </div>
    <div class="home-path-grid">
        <a class="path-card path-card-course" href="/tree">
            <div class="path-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3v5M12 8c-4 0-7 3-7 7M12 8c4 0 7 3 7 7" /><circle cx="5" cy="17" r="2.5" /><circle cx="19" cy="17" r="2.5" /></svg>
            </div>
            <div><h3><T Key="ui.nav.tree" /></h3><p><T Key="ui.dashboard.card.tree.desc" /></p></div>
            <svg class="path-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
        </a>
        <a class="path-card path-card-trainer" href="/trainer">
            <div class="path-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="4" y="5" width="16" height="15" rx="2" /><path d="M8 2v6M8 12h8M8 16h5" /></svg>
            </div>
            <div><h3><T Key="ui.nav.trainer" /></h3><p><T Key="ui.dashboard.card.trainer.desc" /></p></div>
            <svg class="path-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
        </a>
    </div>
</section>

<section class="home-features">
    <div class="section-heading">
        <h2><T Key="ui.dashboard.features.title" /></h2>
    </div>
    <div class="feature-list">
        <article class="feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m5 12 4 4L19 6" /><circle cx="12" cy="12" r="10" /></svg>
            <div><h3><T Key="ui.dashboard.feature.title.exercises" /></h3><p><T Key="ui.dashboard.feature.exercises" /></p></div>
        </article>
        <article class="feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 4h12a3 3 0 0 1 3 3v13H7a3 3 0 0 1-3-3V4Z" /><path d="M8 9h7M8 13h7M8 17h4" /></svg>
            <div><h3><T Key="ui.dashboard.feature.title.morphology" /></h3><p><T Key="ui.dashboard.feature.morphology" /></p></div>
        </article>
        <article class="feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M17 3l4 4-4 4M3 10V9a3 3 0 0 1 3-3h15M7 21l-4-4 4-4M21 14v1a3 3 0 0 1-3 3H3" /></svg>
            <div><h3><T Key="ui.dashboard.feature.title.srs" /></h3><p><T Key="ui.dashboard.feature.srs" /></p></div>
        </article>
        <article class="feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4V5ZM15 9a4 4 0 0 1 0 6M18 6a8 8 0 0 1 0 12" /></svg>
            <div><h3><T Key="ui.dashboard.feature.title.audio" /></h3><p><T Key="ui.dashboard.feature.audio" /></p></div>
        </article>
    </div>
</section>
