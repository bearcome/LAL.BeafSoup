@page "/privacy"
@attribute [AllowAnonymous]
@inject IUiTextProvider UiText

<div class="legal-page">
    <h1><T Key="ui.legal.privacy.title" /></h1>
    @* 正文来自本地化数据层（ui.legal.privacy.body），换行即段落分隔 *@
    <div class="legal-body">@UiText.Text("ui.legal.privacy.body")</div>
    <p><a href="/terms"><T Key="ui.legal.terms.link" /></a></p>
</div>
