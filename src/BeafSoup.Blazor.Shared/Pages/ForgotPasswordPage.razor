@page "/forgot-password"
@attribute [AllowAnonymous]
@inject IdentityApiClient IdentityClient
@inject IUiTextProvider UiText
@inject NavigationManager Navigation

<h1><T Key="ui.auth.forgot.title" /></h1>
<p><T Key="ui.auth.forgot.subtitle" /></p>

<EditForm Model="_model" OnValidSubmit="SubmitAsync">
    <div>
        <label><T Key="ui.auth.email" /></label>
        <InputText @bind-Value="_model.Email" type="email" autocomplete="email" />
    </div>
    <button type="submit" disabled="@_submitting"><T Key="ui.auth.forgot.submit" /></button>
</EditForm>

@if (_accepted)
{
    @* 统一提示：无论邮箱是否注册都显示相同内容，避免枚举账户 *@
    <p role="status"><T Key="ui.auth.forgot.accepted" /></p>
    <p><a href="@ResetUrl"><T Key="ui.auth.reset.submit" /></a></p>
}
@if (_errorKey is not null)
{
    <p role="alert" style="color: var(--color-error);">@UiText.Text(_errorKey)</p>
}

<p><a href="/login"><T Key="ui.auth.link.to-login" /></a></p>

@code {
    private readonly ForgotModel _model = new();
    private bool _submitting;
    private bool _accepted;
    private string? _errorKey;

    private string ResetUrl => $"/reset-password?email={Uri.EscapeDataString(_model.Email.Trim())}";

    private async Task SubmitAsync()
    {
        if (_submitting)
            return;
        _submitting = true;
        _accepted = false;
        _errorKey = null;
        try
        {
            await IdentityClient.RequestPasswordResetAsync(new(_model.Email.Trim()), CancellationToken.None);
            _accepted = true;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            _errorKey = "ui.auth.error.invalid-email";
        }
        catch (HttpRequestException)
        {
            _errorKey = "ui.auth.error.generic";
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class ForgotModel
    {
        public string Email { get; set; } = "";
    }
}
