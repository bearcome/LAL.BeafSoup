@page "/reset-password"
@attribute [AllowAnonymous]
@inject IdentityApiClient IdentityClient
@inject IUiTextProvider UiText

<h1><T Key="ui.auth.reset.title" /></h1>
<p><T Key="ui.auth.reset.subtitle" /></p>

<EditForm Model="_model" OnValidSubmit="SubmitAsync">
    <div>
        <label><T Key="ui.auth.email" /></label>
        <InputText @bind-Value="_model.Email" type="email" autocomplete="email" />
    </div>
    <div>
        <label><T Key="ui.auth.verify.code" /></label>
        <InputText @bind-Value="_model.Code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" />
    </div>
    <div>
        <label><T Key="ui.auth.reset.new-password" /></label>
        <InputText @bind-Value="_model.NewPassword" type="password" autocomplete="new-password" />
    </div>
    <button type="submit" disabled="@_submitting"><T Key="ui.auth.reset.submit" /></button>
</EditForm>

@if (_success)
{
    <p role="status"><T Key="ui.auth.reset.success" /></p>
    <p><a href="/login"><T Key="ui.auth.link.to-login" /></a></p>
}
@if (_errorKey is not null)
{
    <p role="alert" style="color: var(--color-error);">@UiText.Text(_errorKey)</p>
}

@code {
    private readonly ResetModel _model = new();
    private bool _submitting;
    private bool _success;
    private string? _errorKey;

    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery]
    public string? Email { get; set; }

    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery]
    public string? Code { get; set; }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Email))
            _model.Email = Email;
        if (!string.IsNullOrWhiteSpace(Code))
            _model.Code = Code;
    }

    private async Task SubmitAsync()
    {
        if (_submitting)
            return;
        _submitting = true;
        _success = false;
        _errorKey = null;
        try
        {
            await IdentityClient.ResetPasswordAsync(
                new(_model.Email.Trim(), _model.Code.Trim(), _model.NewPassword), CancellationToken.None);
            _success = true;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            // 验证码无效与口令过短合并提示：两者都不回显服务端细节
            _errorKey = "ui.auth.reset.invalid";
        }
        catch (HttpRequestException)
        {
            _errorKey = "ui.auth.error.generic";
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class ResetModel
    {
        public string Email { get; set; } = "";
        public string Code { get; set; } = "";
        public string NewPassword { get; set; } = "";
    }
}
