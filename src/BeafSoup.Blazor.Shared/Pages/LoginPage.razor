@page "/login"
@attribute [AllowAnonymous]
@inject IdentityApiClient IdentityClient
@inject IAuthTokenStore Tokens
@inject AuthStateProvider AuthState
@inject HeartbeatService Heartbeat
@inject AppState AppState
@inject IUiTextProvider UiText
@inject NavigationManager Navigation

<h1><T Key="ui.auth.login.title" /></h1>

<EditForm Model="_model" OnValidSubmit="SubmitAsync">
    <div>
        <label><T Key="ui.auth.email" /></label>
        <InputText @bind-Value="_model.Email" type="email" autocomplete="email" />
    </div>
    <div>
        <label><T Key="ui.auth.password" /></label>
        <InputText @bind-Value="_model.Password" type="password" autocomplete="current-password" />
    </div>
    <button type="submit"><T Key="ui.auth.submit.login" /></button>
</EditForm>

@if (_errorKey is not null)
{
    <p role="alert" style="color: var(--color-error);">@UiText.Text(_errorKey)</p>
}

@if (_needsVerification)
{
    @* 未验证邮箱：直接提供验证入口（邮箱预填）与重发入口 *@
    <p>
        <a href="@VerifyUrl"><T Key="ui.auth.verify.submit" /></a>
    </p>
    <button class="button-secondary" @onclick="ResendAsync" disabled="@_resending">
        <T Key="ui.auth.verify.resend" />
    </button>
    @if (_resent)
    {
        <p role="status"><T Key="ui.auth.verify.sent" /></p>
    }
}

<p><a href="/register"><T Key="ui.auth.link.to-register" /></a></p>
<p><a href="/forgot-password"><T Key="ui.auth.link.forgot-password" /></a></p>
<p class="legal-note">
    <a href="/terms"><T Key="ui.legal.terms.link" /></a>
    <span aria-hidden="true">·</span>
    <a href="/privacy"><T Key="ui.legal.privacy.link" /></a>
</p>

@code {
    private readonly LoginModel _model = new();
    private string? _errorKey;
    private bool _needsVerification;
    private bool _resending;
    private bool _resent;

    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private string VerifyUrl => $"/verify-email?email={Uri.EscapeDataString(_model.Email.Trim())}";

    private async Task SubmitAsync()
    {
        _errorKey = null;
        _needsVerification = false;
        _resent = false;
        try
        {
            var tokens = await IdentityClient.LoginAsync(
                new(_model.Email, _model.Password), CancellationToken.None);
            await Tokens.StoreAsync(tokens, CancellationToken.None);
            AuthState.NotifyLoggedIn();
            await AppState.EnsureProfileAsync(tokens.UserId, CancellationToken.None);
            Heartbeat.Start();
            // 回跳仅限站内地址（相对路径或同站绝对 URL），防开放重定向
            Navigation.NavigateTo(SafeReturnUrl() ?? "/");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            _errorKey = "ui.auth.error.email-not-verified";
            _needsVerification = true;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            _errorKey = "ui.auth.error.invalid-credentials";
        }
        catch (HttpRequestException)
        {
            _errorKey = "ui.auth.error.generic";
        }
    }

    private async Task ResendAsync()
    {
        if (_resending)
            return;
        _resending = true;
        try
        {
            await IdentityClient.RequestEmailVerificationAsync(
                new(_model.Email.Trim()), CancellationToken.None);
            _resent = true;
        }
        catch (HttpRequestException)
        {
            _errorKey = "ui.auth.error.generic";
        }
        finally
        {
            _resending = false;
        }
    }

    private sealed class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }

    private string? SafeReturnUrl()
    {
        if (ReturnUrl is null)
            return null;
        if (Uri.TryCreate(ReturnUrl, UriKind.Relative, out _))
            return ReturnUrl;
        return Uri.TryCreate(ReturnUrl, UriKind.Absolute, out var absolute)
            && string.Equals(absolute.Authority, new Uri(Navigation.BaseUri).Authority, StringComparison.OrdinalIgnoreCase)
            ? absolute.PathAndQuery : null;
    }
}
