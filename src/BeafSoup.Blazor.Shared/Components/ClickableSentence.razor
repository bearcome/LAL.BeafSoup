@using System.Text.Json
@using BeafSoup.Blazor.Shared.Services
@inject IDictionaryCache Dictionary

@* 句子渲染：仅对能在概念词典中命中的词/短语应用链接样式；最长匹配短语整体可点击。 *@
<span class="sentence" lang="@Language">
    @foreach (var segment in _segments)
    {
        if (segment.IsBlank)
        {
            <span class="sentence-blank">@segment.Text</span>
        }
        else if (segment.HasLink)
        {
            <WordInspector Text="@segment.Text" Language="@Language" />
        }
        else
        {
            @segment.Text
        }
    }
</span>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";

    /// <summary>句子语言（词元检索与弹层释义的目标语言）。</summary>
    [Parameter] public string Language { get; set; } = "de-DE";
    [Parameter] public int BlankStart { get; set; }
    [Parameter] public int BlankLength { get; set; }

    private bool _dictionaryReady;
    private string _lastText = "";
    private string _lastLanguage = "";
    private int _lastBlankStart = -1;
    private int _lastBlankLength = -1;
    private IReadOnlyList<SentenceSegment> _segments = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Dictionary.EnsureLoadedAsync(CancellationToken.None);
            _dictionaryReady = true;
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidDataException or JsonException)
        {
            // 词典不可用：句子仍可阅读，只是不显示可点击词
            _dictionaryReady = false;
        }
        RebuildSegments();
    }

    protected override void OnParametersSet()
    {
        if (_lastText != Text || _lastLanguage != Language
            || _lastBlankStart != BlankStart || _lastBlankLength != BlankLength)
        {
            _lastText = Text;
            _lastLanguage = Language;
            _lastBlankStart = BlankStart;
            _lastBlankLength = BlankLength;
            RebuildSegments();
        }
    }

    private void RebuildSegments()
        => _segments = SentenceSegmenter.Build(
            Text, BlankStart, BlankLength,
            phrase => _dictionaryReady && Dictionary.FindBySurface(phrase, Language).Count > 0);
}
