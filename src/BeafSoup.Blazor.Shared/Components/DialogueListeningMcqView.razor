@using System.Text.Json
@inherits GradedExerciseBase
@inject IUiTextProvider UiText

@* 场景对话听力选择题：播放完整对话（逐行连续播放），回答理解题；题目加载后自动播放首行音频，重播有上限且不惩罚。 *@
<div class="card">
    <div class="listening-audio">
        <AudioButton @ref="_audio" Url="@CurrentLineAudio" AutoPlay="true" />
        <button class="button-secondary listening-replay" @onclick="ReplayAsync"
                disabled="@(_replayCount >= MaxReplay || _replaying)">
            @UiText.Text("ui.audio.replay") <span class="replay-count">@_replayCount/@MaxReplay</span>
        </button>
    </div>
    <h2 style="margin-top: var(--spacing-4);">@(Payload.GetProperty("questionText").GetString())</h2>
    <div style="display:grid; gap: var(--spacing-2);">
        @foreach (var option in Options)
        {
            var state = OptionState(option);
            <button style="@OptionStyle(state)" disabled="@(state is "correct")"
                    @onclick="() => SelectAsync(option)">
                @(option.GetProperty("text").GetString())
            </button>
        }
    </div>
    <FeedbackBanner Grade="LastGrade" />
</div>

@code {
    private AudioButton? _audio;
    private int _replayCount;
    private bool _replaying;
    private string? _selected;

    private IEnumerable<JsonElement> Lines => Payload.GetProperty("lines").EnumerateArray();
    private JsonElement[] Options => Payload.GetProperty("options").EnumerateArray().ToArray();
    private int MaxReplay => Payload.TryGetProperty("maxReplayCount", out var max) ? max.GetInt32() : 3;
    private string? CurrentLineAudio => Lines.FirstOrDefault().ValueKind is JsonValueKind.Object
        ? Lines.First().GetProperty("revealedAudioUrl").GetString()
        : null;

    /// <summary>重播按钮真正触发音频播放，只有真正开始播放才计数；达到上限后按钮禁用。</summary>
    private async Task ReplayAsync()
    {
        if (_audio is null || _replayCount >= MaxReplay || _replaying)
            return;
        _replaying = true;
        try
        {
            if (await _audio.TryPlayAsync())
                _replayCount++;
        }
        finally
        {
            _replaying = false;
        }
    }

    private async Task SelectAsync(JsonElement option)
    {
        _selected = option.GetProperty("optionId").GetString();
        using var answer = JsonDocument.Parse($$"""{"optionId":"{{_selected}}"}""");
        await SubmitAsync(answer.RootElement.Clone());
    }

    private string OptionState(JsonElement option)
    {
        var id = option.GetProperty("optionId").GetString();
        if (LastGrade is null || id != _selected)
            return "idle";
        return LastGrade.Correct ? "correct" : "wrong";
    }

    private static string OptionStyle(string state) => state switch
    {
        "correct" => "border-color: var(--color-success); background: var(--color-success-surface);",
        "wrong" => "border-color: var(--color-error); background: var(--color-error-surface);",
        _ => "",
    };
}
