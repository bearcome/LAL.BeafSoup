@inherits LayoutComponentBase
@implements IDisposable
@inject IUiTextProvider UiText
@inject IAuthTokenStore Tokens
@inject IdentityApiClient IdentityClient
@inject AuthStateProvider AuthState
@inject HeartbeatService Heartbeat
@inject AppState AppState
@inject NavigationManager Navigation

<nav class="app-nav">
    <div class="app-nav-inner">
        <a class="app-brand" href="/" aria-label="@UiText.Text("ui.app.title")">
            <svg class="brand-mark" viewBox="0 0 40 40" fill="none" aria-hidden="true">
                <path d="M9 9h16a6 6 0 0 1 6 6v7a6 6 0 0 1-6 6h-8l-7 5v-5H9a5 5 0 0 1-5-5V14a5 5 0 0 1 5-5Z" fill="currentColor" />
                <path d="M12 15h11M12 20h7" stroke="var(--color-primary-contrast)" stroke-width="2.4" stroke-linecap="round" />
                <path d="m29 6 1-3M34 9l3-2" stroke="var(--color-accent)" stroke-width="2.4" stroke-linecap="round" />
            </svg>
            <span><T Key="ui.app.brand" /></span>
        </a>
        <div class="nav-links">
            <NavLink href="/" Match="NavLinkMatch.All"><T Key="ui.nav.home" /></NavLink>
            <NavLink href="/tree"><T Key="ui.nav.tree" /></NavLink>
            <NavLink href="/trainer"><T Key="ui.nav.trainer" /></NavLink>
            <NavLink href="/dialogues"><T Key="ui.nav.dialogues" /></NavLink>
            <NavLink href="/essays"><T Key="ui.nav.essays" /></NavLink>
            <NavLink href="/vocabulary"><T Key="ui.nav.vocabulary" /></NavLink>
            <AuthorizeView>
                <Authorized><NavLink href="/settings"><T Key="ui.nav.settings" /></NavLink></Authorized>
            </AuthorizeView>
        </div>
        <div class="nav-actions">
            <ThemeToggle />
            <AuthorizeView>
                <Authorized><button class="nav-logout" @onclick="LogoutAsync"><T Key="ui.nav.logout" /></button></Authorized>
                <NotAuthorized><a class="nav-login" href="/login"><T Key="ui.nav.login" /></a></NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</nav>

<main class="app-main">
    <ConnectivityBanner />
    <AuthorizeView>
        <Authorized><ProgressHeader /></Authorized>
    </AuthorizeView>
    @Body
    <footer class="app-footer">
        <a href="/privacy"><T Key="ui.legal.privacy.link" /></a>
        <a href="/terms"><T Key="ui.legal.terms.link" /></a>
    </footer>
</main>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override void OnInitialized() => Heartbeat.SessionExpired += OnSessionExpired;

    // 回访会话（令牌仍在本地缓存）：恢复学习配置与进度快照，学习页不再卡在加载态
    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
            return;
        var auth = await AuthStateTask;
        if (auth.User.Identity?.IsAuthenticated == true
            && Guid.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var userId))
        {
            try
            {
                await AppState.EnsureProfileAsync(userId, CancellationToken.None);
                // 回访/刷新后恢复在线心跳：否则服务端会话租约到期会强制登出
                Heartbeat.Start();
            }
            catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                // 服务端会话已失效（租约过期/被顶替）：本地登出，回到匿名态
                OnSessionExpired();
            }
            catch (HttpRequestException)
            {
                // 服务端不可达：ConnectivityBanner 提示，登录后各页会再次拉起配置
            }
        }
    }

    // 心跳发现 401 或令牌过期：清理本地缓存并回到匿名态（权威状态在服务端，ADR-006）
    private void OnSessionExpired()
    {
        Heartbeat.Stop();
        AppState.Reset();
        AuthState.NotifyLoggedOut();
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task LogoutAsync()
    {
        var tokens = Tokens.Tokens;
        if (tokens is not null)
        {
            try
            {
                await IdentityClient.EndSessionAsync(tokens.SessionId, CancellationToken.None);
            }
            catch (HttpRequestException)
            {
                // 服务端不可达也照常清理本地缓存；服务端会话由租约过期收敛
            }
        }
        Heartbeat.Stop();
        AppState.Reset();
        AuthState.NotifyLoggedOut();
        Navigation.NavigateTo("/");
    }

    public void Dispose() => Heartbeat.SessionExpired -= OnSessionExpired;
}
