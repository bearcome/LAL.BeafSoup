@inherits LayoutComponentBase
@implements IDisposable
@inject IUiTextProvider UiText
@inject IAuthTokenStore Tokens
@inject IdentityApiClient IdentityClient
@inject AuthStateProvider AuthState
@inject HeartbeatService Heartbeat
@inject AppState AppState
@inject NavigationManager Navigation

<nav class="app-nav">
    <a href="/"><T Key="ui.nav.home" /></a>
    <a href="/tree"><T Key="ui.nav.tree" /></a>
    <a href="/trainer"><T Key="ui.nav.trainer" /></a>
    <AuthorizeView>
        <Authorized>
            <a href="/settings"><T Key="ui.nav.settings" /></a>
            <button @onclick="LogoutAsync"><T Key="ui.nav.logout" /></button>
        </Authorized>
        <NotAuthorized>
            <a href="/login"><T Key="ui.nav.login" /></a>
        </NotAuthorized>
    </AuthorizeView>
    <ThemeToggle />
</nav>

<main class="exercise-container">
    <ConnectivityBanner />
    <AuthorizeView>
        <Authorized><ProgressHeader /></Authorized>
    </AuthorizeView>
    @Body
</main>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override void OnInitialized() => Heartbeat.SessionExpired += OnSessionExpired;

    // 回访会话（令牌仍在本地缓存）：恢复学习配置与进度快照，学习页不再卡在加载态
    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
            return;
        var auth = await AuthStateTask;
        if (auth.User.Identity?.IsAuthenticated == true
            && Guid.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var userId))
        {
            try
            {
                await AppState.EnsureProfileAsync(userId, CancellationToken.None);
            }
            catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                // 服务端会话已失效（租约过期/被顶替）：本地登出，回到匿名态
                OnSessionExpired();
            }
            catch (HttpRequestException)
            {
                // 服务端不可达：ConnectivityBanner 提示，登录后各页会再次拉起配置
            }
        }
    }

    // 心跳发现 401 或令牌过期：清理本地缓存并回到匿名态（权威状态在服务端，ADR-006）
    private void OnSessionExpired()
    {
        Heartbeat.Stop();
        AppState.Reset();
        AuthState.NotifyLoggedOut();
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task LogoutAsync()
    {
        var tokens = Tokens.Tokens;
        if (tokens is not null)
        {
            try
            {
                await IdentityClient.EndSessionAsync(tokens.SessionId, CancellationToken.None);
            }
            catch (HttpRequestException)
            {
                // 服务端不可达也照常清理本地缓存；服务端会话由租约过期收敛
            }
        }
        Heartbeat.Stop();
        AppState.Reset();
        AuthState.NotifyLoggedOut();
        Navigation.NavigateTo("/");
    }

    public void Dispose() => Heartbeat.SessionExpired -= OnSessionExpired;
}
