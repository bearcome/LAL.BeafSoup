@inherits LayoutComponentBase
@implements IDisposable
@inject IUiTextProvider UiText
@inject IAuthTokenStore Tokens
@inject IdentityApiClient IdentityClient
@inject AuthStateProvider AuthState
@inject HeartbeatService Heartbeat
@inject AppState AppState
@inject NavigationManager Navigation

<nav class="app-nav">
    <a href="/"><T Key="ui.nav.home" /></a>
    <a href="/tree"><T Key="ui.nav.tree" /></a>
    <a href="/trainer"><T Key="ui.nav.trainer" /></a>
    <AuthorizeView>
        <Authorized>
            <a href="/settings"><T Key="ui.nav.settings" /></a>
            <button @onclick="LogoutAsync"><T Key="ui.nav.logout" /></button>
        </Authorized>
        <NotAuthorized>
            <a href="/login"><T Key="ui.nav.login" /></a>
        </NotAuthorized>
    </AuthorizeView>
    <ThemeToggle />
</nav>

<main class="exercise-container">
    <ConnectivityBanner />
    <AuthorizeView>
        <Authorized><ProgressHeader /></Authorized>
    </AuthorizeView>
    @Body
</main>

@code {
    protected override void OnInitialized() => Heartbeat.SessionExpired += OnSessionExpired;
    private void OnSessionExpired() => InvokeAsync(StateHasChanged);

    private async Task LogoutAsync()
    {
        var tokens = Tokens.Tokens;
        if (tokens is not null)
        {
            try
            {
                await IdentityClient.EndSessionAsync(tokens.SessionId, CancellationToken.None);
            }
            catch (HttpRequestException)
            {
                // 服务端不可达也照常清理本地缓存；服务端会话由租约过期收敛
            }
        }
        Heartbeat.Stop();
        AppState.Reset();
        AuthState.NotifyLoggedOut();
        Navigation.NavigateTo("/");
    }

    public void Dispose() => Heartbeat.SessionExpired -= OnSessionExpired;
}
