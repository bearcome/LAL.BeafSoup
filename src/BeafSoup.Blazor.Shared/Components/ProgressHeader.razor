@inject AppState AppState
@inject IUiTextProvider UiText
@implements IDisposable

@if (AppState.Progress is { } progress)
{
    <div class="progress-header" role="status">
        <span class="progress-item progress-hearts">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" /></svg>
            <span>@UiText.Text("ui.progress.hearts")</span><strong>@progress.Hearts</strong>
        </span>
        <span class="progress-item progress-xp">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m13 2-9 12h7l-1 8 9-12h-7l1-8Z" /></svg>
            <span>@UiText.Text("ui.progress.xp")</span><strong>@progress.Xp</strong>
        </span>
        <span class="progress-item progress-streak">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 22c4 0 7-3 7-7 0-5-4-7-3-12-4 2-5 5-5 8-2-1-3-3-3-5-2 2-3 5-3 8 0 5 3 8 7 8Z" /></svg>
            <span>@UiText.Text("ui.progress.streak")</span><strong>@progress.DayStreak</strong>
        </span>
    </div>
}

@code {
    protected override void OnInitialized() => AppState.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => AppState.Changed -= OnChanged;
}
