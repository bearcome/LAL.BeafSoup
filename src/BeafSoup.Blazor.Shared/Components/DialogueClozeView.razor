@using System.Text.Json
@inherits GradedExerciseBase
@inject IUiTextProvider UiText
@inject IDictionaryCache Dictionary

@* 补全对话：整段按行顺序连续播放（每行各自音色，绝不朗读说话人标签）；每行也可单独播放。 *@
<div class="card">
    <div style="display:flex; gap: var(--spacing-2); align-items:flex-start;">
        <AudioSequenceButton Urls="LineAudioUrls" AutoPlay="true" LabelKey="ui.audio.play-dialogue" />
        <AudioButton Url="@_optionAudioUrl" AutoPlay="true" ShowControl="false" PlayRequest="_optionAudioRequest" />
    </div>
    @foreach (var line in Lines)
    {
        <div class="dialogue-line" style="margin-top: var(--spacing-3);">
            <div>
                <span class="dialogue-speaker">@(line.GetProperty("speakerLabel").GetString()):</span>
                @if (line.TryGetProperty("blank", out var blank))
                {
                    <ClickableSentence Text="@line.GetProperty("text").GetString()" Language="@TargetLanguage"
                                       BlankStart="@blank.GetProperty("start").GetInt32()"
                                       BlankLength="@blank.GetProperty("length").GetInt32()" />
                }
                else
                {
                    <ClickableSentence Text="@line.GetProperty("text").GetString()" Language="@TargetLanguage"
                                       BlankStart="0" BlankLength="0" />
                }
            </div>
            <AudioButton Url="@LineAudio(line)" />
        </div>
    }

    @if (IsChoice)
    {
        <div style="display:grid; gap: var(--spacing-2); margin-top: var(--spacing-4);">
            @foreach (var option in BlankOptions)
            {
                var state = OptionState(option);
                <button style="@OptionStyle(state)" disabled="@(state is "correct")"
                        @onclick="() => SelectAsync(option)">
                    @(option.GetProperty("text").GetString())
                </button>
            }
        </div>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="SubmitInputAsync" style="margin-top: var(--spacing-4); display:flex; gap: var(--spacing-2);">
            <InputText @bind-Value="_model.Text" placeholder="@UiText.Text("ui.exercise.type-hint")"
                       style="flex:1;" autocomplete="off" />
            <button type="submit" disabled="@GradingInProgress">@UiText.Text("ui.exercise.check")</button>
        </EditForm>
    }
    <FeedbackBanner Grade="LastGrade" />
</div>

@code {
    private readonly InputModel _model = new();
    private string? _selected;
    private string? _optionAudioUrl;
    private int _optionAudioRequest;

    private IEnumerable<JsonElement> Lines => Payload.GetProperty("lines").EnumerateArray();
    private bool IsChoice => string.Equals(Payload.GetProperty("responseMode").GetString(), "Choice", StringComparison.OrdinalIgnoreCase);
    private JsonElement Blank => Lines.Select(l => l.TryGetProperty("blank", out var b) ? b : default)
        .First(b => b.ValueKind is JsonValueKind.Object);
    private IEnumerable<JsonElement> BlankOptions => Blank.GetProperty("options").EnumerateArray();
    private string TargetLanguage => AppState.CurrentProfile?.TargetLanguage ?? "de-DE";

    /// <summary>整段播放：按行顺序取每行补全版音频；缺音频的行不参与排序。</summary>
    private IReadOnlyList<string?> LineAudioUrls => Lines
        .Select(LineAudio)
        .Where(url => !string.IsNullOrWhiteSpace(url))
        .ToArray();

    private static string? LineAudio(JsonElement line)
        => line.TryGetProperty("revealedAudioUrl", out var audio) ? audio.GetString() : null;

    private async Task SelectAsync(JsonElement option)
    {
        _selected = option.GetProperty("optionId").GetString();
        // 目标语言选项：选中即播放对应词元音频（解析失败保持静默，不阻断判分）
        var text = option.GetProperty("text").GetString() ?? "";
        _optionAudioUrl = Dictionary.FindPrimaryAudioUrl(text, TargetLanguage);
        _optionAudioRequest++;
        using var answer = JsonDocument.Parse($$"""{"lineIndex":{{BlankLineIndex}},"optionId":"{{_selected}}"}""");
        await SubmitAsync(answer.RootElement.Clone());
    }

    private async Task SubmitInputAsync()
    {
        using var answer = JsonDocument.Parse(JsonSerializer.Serialize(
            new { lineIndex = BlankLineIndex, optionId = (string?)null, text = _model.Text }));
        await SubmitAsync(answer.RootElement.Clone());
        if (LastGrade is { Correct: false })
            _model.Text = "";
    }

    private int BlankLineIndex => Lines.Select((l, i) => (l, i))
        .First(t => t.l.TryGetProperty("blank", out _)).i;

    private string OptionState(JsonElement option)
    {
        var id = option.GetProperty("optionId").GetString();
        if (LastGrade is null || id != _selected)
            return "idle";
        return LastGrade.Correct ? "correct" : "wrong";
    }

    private static string OptionStyle(string state) => state switch
    {
        "correct" => "border-color: var(--color-success); background: var(--color-success-surface);",
        "wrong" => "border-color: var(--color-error); background: var(--color-error-surface);",
        _ => "",
    };

    private sealed class InputModel
    {
        public string Text { get; set; } = "";
    }
}
