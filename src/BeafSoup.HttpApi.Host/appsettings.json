{
  "ConnectionStrings": {
    "Default": "Data Source=beafsoup.db"
  },
  "Presence": {
    "HeartbeatIntervalSeconds": 30,
    "LeaseTtlSeconds": 90,
    "MaxTimingWindowSeconds": 300
  },
  "Jwt": {
    "Issuer": "BeafSoup",
    "Audience": "BeafSoup.Client",
    "SigningKey": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
