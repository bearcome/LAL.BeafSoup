  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>BeafSoup.Audio.Generation</RootNamespace>
    <!-- 离线生成工具允许引用各模块 Domain；它不是 Blazor 客户端，也不进入 WASM 产物 -->
