  <ItemGroup>
    <InternalsVisibleTo Include="BeafSoup.Audio.Generation.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Modules/Audio/BeafSoup.Audio.Domain/BeafSoup.Audio.Domain.csproj" />
    <ProjectReference Include="../Modules/Localization/BeafSoup.Localization.Domain/BeafSoup.Localization.Domain.csproj" />
    <ProjectReference Include="../Modules/Vocabulary/BeafSoup.Vocabulary.Domain/BeafSoup.Vocabulary.Domain.csproj" />
    <ProjectReference Include="../Modules/Content/BeafSoup.Content.Domain/BeafSoup.Content.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
